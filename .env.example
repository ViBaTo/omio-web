# PostHog EU. Las NEXT_PUBLIC_* se incrustan en el build: hay que
# definirlas también en Railway (no basta con ponerlas en runtime).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Origen del servicio de control (URL de Railway, sin path). Si no está,
# /control responde 404 y la web se comporta como hasta ahora.
# Ejemplo: https://omio-control.up.railway.app
CONTROL_ORIGIN=
